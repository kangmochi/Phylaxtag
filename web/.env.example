# Copy to web/.env for a local run. Do not commit web/.env.
# No testnet deploy in this task: the contract id stays a placeholder.
# The app never asks for a key or a seed phrase. You connect your own testnet wallet.

VITE_CONTRACT_ID=your-contract.testnet
VITE_RPC_URL=https://rpc.testnet.near.org
VITE_NETWORK_ID=testnet

# Leave VITE_TEST_WALLET unset for a real build. Set it to 1 only for the
# Playwright tests. That build flag pulls in a test wallet with no keys.
# The production bundle must not contain it.
